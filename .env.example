# GEMINI_API_KEY: Required for server-side Gemini AI calls.
# Never expose this key in client-side code.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# AI_PROVIDER: "gemini" (uses GEMINI_API_KEY when set) or "mock" (deterministic offline fallback)
AI_PROVIDER="gemini"

# APP_URL: Public URL of the AccessPath deployment
APP_URL="http://localhost:3000"

# PORT: Server port (must be 3000 in AI Studio preview)
PORT="3000"

# MONGODB_URI: Optional MongoDB Atlas connection string.
# If omitted in local development, AccessPath runs using the local persistent JSON store in data/accesspath-db.json.
MONGODB_URI=""

# JWT_SECRET: Secret used to sign session tokens (minimum 32 chars in production)
JWT_SECRET="replace-with-a-long-random-secret-in-production"

# EMAIL_PROVIDER: "none" | "smtp" | "resend"
EMAIL_PROVIDER="none"
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="noreply@accesspath.example.edu"

# STORAGE_PROVIDER: "local" | "s3"
STORAGE_PROVIDER="local"

# ALLOW_DEMO_SEED: Development-only toggle ("true" in dev; automatically disabled when NODE_ENV=production)
ALLOW_DEMO_SEED="true"

# SEED_DEMO_PASSWORD: Password used only by local development seed script for synthetic demo accounts
SEED_DEMO_PASSWORD="AccessPathDemo!2026"
